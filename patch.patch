+      await service.update('u1', 't1', { amount: '999', note: null });
+      const call = prisma.transaction.updateMany.mock.calls[0][0];
+      expect(call.where).toEqual({ id: 't1', userId: 'u1' });
+      expect(call.data).toMatchObject({ amount: 999n, note: null });
