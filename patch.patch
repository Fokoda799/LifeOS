diff --git a/apps/web/src/features/money/categories/emoji-picker.tsx b/apps/web/src/features/money/categories/emoji-picker.tsx
new file mode 100644
index 0000000..57169e4
--- /dev/null
+++ b/apps/web/src/features/money/categories/emoji-picker.tsx
@@ -0,0 +1,66 @@
+"use client";
+
+import { EmojiPicker as Picker } from "frimousse";
+import { useLocale, useTranslations } from "next-intl";
+
+/**
+ * Searchable emoji picker (frimousse, unstyled), styled with our tokens.
+ * Emoji data comes from the Emojibase CDN and has English and French names;
+ * Arabic users get the English search names.
+ */
+export function EmojiPicker({ onSelect }: { onSelect: (emoji: string) => void }) {
+  const t = useTranslations("Money.categories");
+  const locale = useLocale();
+
+  return (
+    <Picker.Root
+      locale={locale === "fr" ? "fr" : "en"}
+      columns={8}
+      onEmojiSelect={({ emoji }) => onSelect(emoji)}
+      // Enter in the search box must not submit the surrounding form.
+      onKeyDownCapture={(e) => e.key === "Enter" && e.preventDefault()}
+      className="flex h-72 w-full flex-col rounded-2xl border-2 border-border bg-card"
+    >
+      <Picker.Search
+        autoFocus
+        aria-label={t("emojiSearch")}
+        placeholder={t("emojiSearch")}
+        className="m-2 h-10 rounded-xl border-2 border-input bg-muted px-3 text-sm outline-none focus-visible:border-ring focus-visible:bg-background"
+      />
+      <Picker.Viewport className="min-h-0 flex-1 outline-none">
+        <Picker.Loading className="grid h-full place-items-center text-sm text-muted-foreground">
+          {t("emojiLoading")}
+        </Picker.Loading>
+        <Picker.Empty className="grid h-full place-items-center text-sm text-muted-foreground">
+          {t("emojiEmpty")}
+        </Picker.Empty>
+        <Picker.List
+          components={{
+            CategoryHeader: ({ category, ...props }) => (
+              <div
+                {...props}
+                className="bg-card px-3 pt-3 pb-1.5 text-xs font-bold text-muted-foreground"
+              >
+                {category.label}
+              </div>
+            ),
+            Row: ({ children, ...props }) => (
+              <div {...props} className="scroll-my-1.5 px-1.5">
+                {children}
+              </div>
+            ),
+            Emoji: ({ emoji, ...props }) => (
+              <button
+                {...props}
+                type="button"
+                className="flex size-9 items-center justify-center rounded-lg text-xl data-[active]:bg-accent"
+              >
+                {emoji.emoji}
+              </button>
+            ),
+          }}
+        />
+      </Picker.Viewport>
+    </Picker.Root>
+  );
+}
