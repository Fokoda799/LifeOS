@@ -0,0 +1,41 @@
+import { computeDeltas } from './balance';
+
+describe('computeDeltas', () => {
+  it('adds income and subtracts expenses', () => {
+    const d = computeDeltas(
+      [
+        { accountId: 'a', type: 'income', sum: 10_000n },
+        { accountId: 'a', type: 'expense', sum: 2_500n },
+      ],
+      [],
+    );
+    expect(d.get('a')).toBe(7_500n);
+  });
+
+  it('moves a transfer out of the source and into the destination', () => {
+    const d = computeDeltas(
+      [{ accountId: 'a', type: 'transfer', sum: 4_000n }],
+      [{ accountId: 'b', sum: 4_000n }],
+    );
+    expect(d.get('a')).toBe(-4_000n);
+    expect(d.get('b')).toBe(4_000n);
+  });
+
+  it('combines everything that touches one account and leaves others out', () => {
+    const d = computeDeltas(
+      [
+        { accountId: 'a', type: 'income', sum: 1_000n },
+        { accountId: 'a', type: 'transfer', sum: 300n },
+      ],
+      [{ accountId: 'a', sum: 50n }],
+    );
+    expect(d.get('a')).toBe(750n);
+    expect(d.has('z')).toBe(false);
+  });
+
+  it('is exact above 2^53', () => {
+    const big = 9_007_199_254_740_993n;
+    const d = computeDeltas([{ accountId: 'a', type: 'income', sum: big }], []);
+    expect(d.get('a')).toBe(big);
+  });
+});
diff --git a/apps/api/src/money/transactions/balance.ts b/apps/api/src/money/transactions/balance.ts
new file mode 100644
index 0000000..80b0b21
--- /dev/null
+++ b/apps/api/src/money/transactions/balance.ts
@@ -0,0 +1,24 @@
+export type OutgoingSum = {
+  accountId: string;
+  type: 'income' | 'expense' | 'transfer';
+  sum: bigint;
+};
+export type IncomingSum = { accountId: string; sum: bigint };
+
+/**
+ * What the transactions add to or take from each account's opening balance.
+ * Income adds. Expense and the source side of a transfer subtract. The destination of a
+ * transfer adds. Balances are always computed from this, never stored.
+ */
+export function computeDeltas(
+  outgoing: OutgoingSum[],
+  incoming: IncomingSum[],
+): Map<string, bigint> {
+  const deltas = new Map<string, bigint>();
+  const add = (id: string, amount: bigint) =>
+    deltas.set(id, (deltas.get(id) ?? 0n) + amount);
+  for (const r of outgoing)
+    add(r.accountId, r.type === 'income' ? r.sum : -r.sum);
+  for (const r of incoming) add(r.accountId, r.sum);
+  return deltas;
+}
