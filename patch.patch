@@ -0,0 +1,30 @@
+import { summarize } from './summary';
+
+describe('summarize', () => {
+  it('totals income, expense and net per currency, sorted by currency', () => {
+    expect(
+      summarize([
+        { currency: 'MAD', type: 'income', sum: 500_000n },
+        { currency: 'MAD', type: 'expense', sum: 120_050n },
+        { currency: 'EUR', type: 'expense', sum: 2_000n },
+      ]),
+    ).toEqual([
+      { currency: 'EUR', income: '0', expense: '2000', net: '-2000' },
+      { currency: 'MAD', income: '500000', expense: '120050', net: '379950' },
+    ]);
+  });
+
+  it('ignores transfers and returns nothing when there is nothing to total', () => {
+    expect(summarize([{ currency: 'MAD', type: 'transfer', sum: 9n }])).toEqual(
+      [],
+    );
+    expect(summarize([])).toEqual([]);
+  });
+
+  it('stays exact above 2^53', () => {
+    const big = 9_007_199_254_740_993n;
+    expect(
+      summarize([{ currency: 'MAD', type: 'income', sum: big }])[0].income,
+    ).toBe('9007199254740993');
+  });
+});
diff --git a/apps/api/src/money/transactions/summary.ts b/apps/api/src/money/transactions/summary.ts
new file mode 100644
index 0000000..13cf085
--- /dev/null
+++ b/apps/api/src/money/transactions/summary.ts
@@ -0,0 +1,26 @@
+import type { TransactionsSummary } from '@lifeos/shared';
+
+export type SumRow = {
+  currency: string;
+  type: 'income' | 'expense' | 'transfer';
+  sum: bigint;
+};
+
+/** Income, expense and net per currency. Transfers move money, they don't earn or spend it. */
+export function summarize(rows: SumRow[]): TransactionsSummary['totals'] {
+  const byCurrency = new Map<string, { income: bigint; expense: bigint }>();
+  for (const r of rows) {
+    if (r.type === 'transfer') continue;
+    const t = byCurrency.get(r.currency) ?? { income: 0n, expense: 0n };
+    t[r.type] += r.sum;
+    byCurrency.set(r.currency, t);
+  }
+  return [...byCurrency.entries()]
+    .sort(([a], [b]) => a.localeCompare(b))
+    .map(([currency, t]) => ({
+      currency,
+      income: t.income.toString(),
+      expense: t.expense.toString(),
+      net: (t.income - t.expense).toString(),
+    }));
+}
