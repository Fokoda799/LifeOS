@@ -0,0 +1,58 @@
+"use client";
+
+import { ChevronLeft, ChevronRight } from "lucide-react";
+import { useLocale, useTranslations } from "next-intl";
+import { Button } from "@/components/ui/button";
+import { shiftPeriod, type Period } from "./period";
+
+/** Previous / next month, plus a switch between one month and all time. */
+export function MonthSwitcher({
+  period,
+  onChange,
+  currentMonth,
+}: {
+  /** null = all time */
+  period: Period | null;
+  onChange: (period: Period | null) => void;
+  currentMonth: Period;
+}) {
+  const t = useTranslations("Money.transactions");
+  const locale = useLocale();
+
+  const label = period
+    ? new Intl.DateTimeFormat(`${locale}-u-nu-latn`, {
+        month: "long",
+        year: "numeric",
+        timeZone: "UTC",
+      }).format(new Date(Date.UTC(period.year, period.month, 1)))
+    : t("allTime");
+
+  return (
+    <div className="flex items-center gap-2">
+      <Button
+        variant="outline"
+        size="icon-sm"
+        aria-label={t("periodPrevious")}
+        disabled={!period}
+        onClick={() => period && onChange(shiftPeriod(period, -1))}
+      >
+        <ChevronLeft aria-hidden className="rtl:-scale-x-100" />
+      </Button>
+      <p aria-live="polite" className="min-w-36 text-center font-extrabold">
+        {label}
+      </p>
+      <Button
+        variant="outline"
+        size="icon-sm"
+        aria-label={t("periodNext")}
+        disabled={!period}
+        onClick={() => period && onChange(shiftPeriod(period, 1))}
+      >
+        <ChevronRight aria-hidden className="rtl:-scale-x-100" />
+      </Button>
+      <Button variant="ghost" size="sm" onClick={() => onChange(period ? null : currentMonth)}>
+        {period ? t("allTime") : t("thisMonth")}
+      </Button>
+    </div>
+  );
+}
diff --git a/apps/web/src/features/money/transactions/period.ts b/apps/web/src/features/money/transactions/period.ts
new file mode 100644
index 0000000..a18fcb6
--- /dev/null
+++ b/apps/web/src/features/money/transactions/period.ts
@@ -0,0 +1,22 @@
+/** A calendar month. `month` is 0-11, like Date. */
+export type Period = { year: number; month: number };
+
+export function currentPeriod(now = new Date()): Period {
+  return { year: now.getFullYear(), month: now.getMonth() };
+}
+
+export function shiftPeriod({ year, month }: Period, by: number): Period {
+  const d = new Date(Date.UTC(year, month + by, 1));
+  return { year: d.getUTCFullYear(), month: d.getUTCMonth() };
+}
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+/** First and last day of the month as "YYYY-MM-DD", the format the API filters by. */
+export function periodBounds({ year, month }: Period): { from: string; to: string } {
+  const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
+  return {
+    from: `${year}-${pad(month + 1)}-01`,
+    to: `${year}-${pad(month + 1)}-${pad(lastDay)}`,
+  };
+}
