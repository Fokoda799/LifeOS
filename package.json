{
  "name": "lifeos",
  "private": true,
  "scripts": {
    "setup": "pnpm install && pnpm --filter api db:generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "prepare": "husky",
    "openapi:export": "curl -fsS http://localhost:4000/docs-json -o apps/api/openapi.json"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,css}": "prettier --write"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "6.0.3"
  }
}
