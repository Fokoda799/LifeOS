generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  locale       String   @default("en")
  currency     String   @default("MAD")

  refreshTokens RefreshToken[]
  emailVerifiedAt DateTime?
  tools       UserTool[]
  accounts Account[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}


enum VerificationPurpose {
  REGISTER
  PASSWORD_RESET
}

model VerificationCode {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose, createdAt])
  @@map("verification_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}


enum ToolId {
  money
  tasks
  training
} 

model UserTool {
  userId    String
  toolId    ToolId
  addedAt   DateTime  @default(now())
  /// Set when the user removes the tool. The tool is hidden, its data is kept.
  removedAt DateTime?
  deletionScheduledFor DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, toolId])
  @@index([deletionScheduledFor])
  @@map("user_tools")
}


enum AccountType {
  cash
  bank
  savings
  credit_card
  e_wallet
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  /// ISO 4217 code. Fixed after creation.
  currency       String
  /// Minor units. May be negative (e.g. an existing card debt).
  openingBalance BigInt      @default(0)
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, archivedAt])
  @@map("accounts")
}
