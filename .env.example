# Database
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_dev_password
POSTGRES_DB=lifeos
DATABASE_URL=postgresql://lifeos:lifeos_dev_password@localhost:5431/lifeos?schema=public

# API
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Auth (generate real values with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
